{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",  // 👈 Cambiar de "commonjs" a "Node16"
    "lib": ["ES2022"],
    "outDir": "./built",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node16",  // 👈 Coherente con "module"
    "allowJs": true,
    "noEmit": false,
    "types": [],  // 👈 Para evitar conflictos con @types/node
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "built",
    "**/*.spec.ts",
    "node_modules/@types/node/**/*"
  ]
}